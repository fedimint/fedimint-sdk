{
  "name": "@fedimint/react-native",
  "description": "The Fedimint SDK for React Native: rust/fedimint-sdk through its generated bindings",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fedimint/fedimint-sdk.git",
    "directory": "js/react-native/react-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/commonjs/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "app.plugin.js",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rm -rf lib tsconfig.tsbuildinfo",
    "clean:deep": "pnpm run clean && rm -rf node_modules",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@fedimint/react-native-bindings": "workspace:*",
    "react": ">=18.0.0",
    "react-native": ">=0.78.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "^54.0.4",
    "@fedimint/react-native-bindings": "workspace:*",
    "@types/node": "^22.19.11",
    "expo-module-scripts": "^5.0.8",
    "react-native-builder-bob": "^0.40.18",
    "typescript": "^6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
