<?xml version="1.0" encoding="utf-8"?>
<!-- The library manifest Android Gradle Plugin 7.3 and later read (see build.gradle); ubrn's
     AndroidManifest.xml is only used by older ones. Not generated by ubrn, so kept by hand. Its
     permissions merge into every app using the bindings, as the Kotlin SDK's AAR does. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android has no readable resolv.conf, so the DNS resolver under iroh asks
         ConnectivityManager for the active network's DNS servers, and
         getActiveNetwork/getLinkProperties require this. Without it the call throws
         a SecurityException and the resolver falls back to public DNS servers,
         which fails on networks that block them. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
