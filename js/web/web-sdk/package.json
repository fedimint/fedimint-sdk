{
  "name": "@fedimint/web-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "The Fedimint SDK for browsers: rust/fedimint-sdk as WebAssembly in a worker",
  "keywords": [
    "fedimint",
    "bitcoin",
    "lightning",
    "ecash",
    "wallet",
    "wasm",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fedimint/fedimint-sdk.git",
    "directory": "js/web/web-sdk"
  },
  "bugs": {
    "url": "https://github.com/fedimint/fedimint-sdk/issues"
  },
  "homepage": "https://github.com/fedimint/fedimint-sdk/tree/main/js/web/web-sdk#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/worker.js"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-wasm.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "clean:deep": "pnpm run clean && rm -rf node_modules",
    "generate": "../../../scripts/generate-sdk-web-bindings.sh",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6",
    "@ubjs/wasm": "0.31.0-6"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
