{
  "name": "@fedimint/fedimint-sdk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm clean && pnpm run --r --filter \"./shared/**\" --filter \"./web/**\" --filter \"./tools/**\" build",
    "build:reactnative": "pnpm run --r --filter @fedimint/react-native-bindings --filter @fedimint/react-native build",
    "build:wasm": "bash ../scripts/build_wasm.sh",
    "clean": "pnpm run --r --parallel clean && rm -rf shared/**/*.json.tmp web/**/*.json.tmp react-native/**/*.json.tmp tools/**/*.json.tmp",
    "clean:deep": "rm -rf node_modules && pnpm run --r --parallel clean:deep",
    "deps": "pnpx taze -r",
    "dev": "pnpm build && pnpm dev:vite",
    "dev:react": "pnpm --filter react dev",
    "dev:vite": "pnpm --filter vite-core dev",
    "dev:bare": "pnpm run --filter bare-js server",
    "dev:webpack": "pnpm --filter webpack-app build && pnpm --filter webpack-app start",
    "dev:next": "pnpm run --filter next-js dev",
    "docs:dev": "pnpm run --filter docs docs:dev",
    "docs:build": "pnpm run --filter docs docs:build",
    "docs:preview": "pnpm run --filter docs docs:preview",
    "typedoc": "pnpm run --r --filter \"./shared/**\" --filter \"./web/**\" --filter \"./react-native/**\" --filter \"./tools/**\" typedoc",
    "lint": "prettier --check .. --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "lint:fix": "prettier --write .. --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "lint:repo": "sherif",
    "preinstall": "pnpx only-allow pnpm",
    "prepare": "pnpm simple-git-hooks",
    "postinstall": "patch-package",
    "preview": "pnpm --filter vite-core preview",
    "reset": "pnpm clean && pnpm build && pnpm preview",
    "changeset": "changeset",
    "version": "changeset version",
    "typecheck": "pnpm run --r --parallel --filter \"!@fedimint/react-native\" --filter \"!@fedimint/react-native-bindings\" typecheck",
    "coverage": "vitest run --coverage",
    "test": "pnpm run test:setup pnpm run test:lib",
    "test:setup": "bash ../scripts/setup_test_shell.sh",
    "test:coverage": "vitest run --coverage",
    "test:lib": "vitest --project integration-tests",
    "test:reactnative": "vitest --project react-native",
    "test:unit": "vitest --project unit",
    "test:create": "vitest --watch=false --project cli",
    "test:ui": "vitest --browser.headless=false --ui",
    "format": "prettier --write .. --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "watch": "pnpm run --r --parallel --filter \"./shared/**\" --filter \"./web/**\" --filter \"./react-native/**\" --filter \"./tools/**\" watch",
    "ubrn:android": "pnpm --filter react-native-bindings ubrn:android",
    "ubrn:android:release": "pnpm --filter react-native-bindings ubrn:android:release",
    "ubrn:clean": "pnpm --filter react-native-bindings ubrn:clean",
    "ubrn:ios": "pnpm --filter react-native-bindings ubrn:ios",
    "ubrn:ios:release": "pnpm --filter react-native-bindings ubrn:ios:release"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^22.19.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "execa": "^9.6.1",
    "glob": "^10.4.5",
    "happy-dom": "^20.7.0",
    "patch-package": "^8.0.1",
    "playwright": "1.56.1",
    "prettier": "^3.8.1",
    "sherif": "^0.8.4",
    "simple-git-hooks": "^2.13.1",
    "typescript": "6.0.3",
    "unicorn-magic": "^0.3.0",
    "vite": "^7.0.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm --dir js run lint"
  }
}
