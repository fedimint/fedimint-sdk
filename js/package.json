{
  "name": "@fedimint/fedimint-sdk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm clean && pnpm run --r --filter \"./web/**\" build",
    "build:reactnative": "pnpm run --r --filter @fedimint/react-native-bindings --filter @fedimint/react-native build",
    "clean": "pnpm run --r --parallel clean && rm -rf web/**/*.json.tmp react-native/**/*.json.tmp",
    "clean:deep": "rm -rf node_modules && pnpm run --r --parallel clean:deep",
    "deps": "pnpx taze -r",
    "lint": "prettier --check .. --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "lint:fix": "prettier --write .. --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "lint:repo": "sherif",
    "preinstall": "pnpx only-allow pnpm",
    "prepare": "pnpm simple-git-hooks",
    "postinstall": "patch-package",
    "typecheck": "pnpm run --r --parallel --filter \"!@fedimint/react-native\" --filter \"!@fedimint/react-native-bindings\" --filter \"!react-native-sdk-example\" --filter \"!expo-app-example\" typecheck",
    "coverage": "vitest run --coverage",
    "test": "pnpm run test:setup pnpm run test:lib",
    "test:setup": "bash ../scripts/setup_test_shell.sh",
    "test:coverage": "vitest run --coverage",
    "test:lib": "vitest --project sdk-web",
    "test:reactnative": "vitest --project react-native",
    "test:unit": "vitest --project unit",
    "test:ui": "vitest --browser.headless=false --ui",
    "format": "prettier --write .. --ignore-path ../.gitignore --ignore-path ../.prettierignore"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "happy-dom": "^21.0.1",
    "patch-package": "^8.0.1",
    "playwright": "1.56.1",
    "prettier": "^3.9.10",
    "sherif": "^1.13.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm --dir js run lint"
  }
}
