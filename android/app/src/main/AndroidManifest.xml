<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- sdk.preview and sdk.join both talk to guardians. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Scanning QR codes: invoices, addresses, invite codes, notes. Asked for
         only when the user taps Scan; everything else works without it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".FedimintApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FedimintWallet">
    </application>

</manifest>
